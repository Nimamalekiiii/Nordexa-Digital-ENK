# Kopier denne filen til ".env" og fyll inn. Ikke del .env med noen og ikke legg den på GitHub.

# --- Om bedriften -----------------------------------------------------------
# Organisasjonsnummer. Vises i bunnteksten, personvernerklæringen og vilkårene.
ORG_NR=

# Vises under prisene, f.eks.: Alle priser er oppgitt eks. mva.
PRICE_NOTE=

# E-postadressen som vises på siden og som får varsler.
CONTACT_EMAIL=nordexadigital.no@gmail.com

# Lenker i bunnteksten. La stå tomt for å skjule.
LINKEDIN_URL=
INSTAGRAM_URL=

# --- E-postvarsler ----------------------------------------------------------
# App-passord fra Google-kontoen (ikke det vanlige passordet).
# Uten dette lagres alt fortsatt i admin, men du får ikke e-postvarsel.
MAIL_USERNAME=nordexadigital.no@gmail.com
MAIL_PASSWORD=

# --- Admin ------------------------------------------------------------------
# Brukes bare første gang admin-brukeren lages. Tom = et tilfeldig passord skrives ut i Terminal.
# Bytt passord senere med:  .venv/bin/python app.py nytt-passord
ADMIN_PASSWORD=

# --- Når siden er publisert --------------------------------------------------
# Adressen til siden, f.eks. https://nordexadigital.no
SITE_URL=
# Sett til 1 når siden ligger på HTTPS.
COOKIE_SECURE=0
# Sett til 1 hos Railway, Render og lignende (de står foran appen som mellomledd).
BEHIND_PROXY=0
# Sett til 0 på en ekte server.
FLASK_DEBUG=1
# Lang, tilfeldig tekst. Tom = lages automatisk og lagres i instance/secret_key.
SECRET_KEY=
# Database. Tom = SQLite-filen i instance/. Hos Railway: lim inn adressen til PostgreSQL.
DATABASE_URL=
